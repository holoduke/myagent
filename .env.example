# ═══ ARIA — Required ═══

# Your WhatsApp phone number in international format (e.g. 31612345678)
OWNER_PHONE=

# Your name (used in personality prompts)
OWNER_NAME=

# Anthropic API key for Claude
CLAUDE_API_KEY=

# Web dashboard password (leave empty to disable auth)
WEB_PASSWORD=

# ═══ Brain — Autonomous Reasoning ═══

# BRAIN_ENABLED=true
# BRAIN_MAX_MESSAGES_PER_DAY=5
# BRAIN_MIN_MESSAGE_INTERVAL=7200000       # ms between proactive messages (default: 2h)
# BRAIN_QUIET_START=23                     # hour to stop messaging (0-23)
# BRAIN_QUIET_END=7                        # hour to resume messaging (0-23)
# BRAIN_THINK_COOLDOWN=300000              # ms between think ticks (default: 5m)
# BRAIN_CONSOLIDATE_INTERVAL=14400000      # ms between consolidation (default: 4h)
# BRAIN_REFLECT_INTERVAL=43200000          # ms between reflection (default: 12h)
# BRAIN_TICK_INTERVAL=60000                # ms brain loop tick (default: 60s)
# BRAIN_OBSERVATION_DAYS=7                 # days to retain raw observations
# BRAIN_TOOLS=Bash,Read,Write,Edit,Glob,Grep,WebFetch,WebSearch

# ═══ Self-Improvement ═══

# SELF_IMPROVE_ENABLED=true
# SELF_IMPROVE_AUTO_APPROVE=false
# SELF_IMPROVE_MAX_PER_WEEK=3

# GitHub repo for self-improvement PRs (owner/repo format)
# GITHUB_REPO=
# GH_TOKEN=

# ═══ Claude Provider ═══

# CLAUDE_TIMEOUT=300000                    # API call timeout in ms (default: 5m)
# CLAUDE_ALLOWED_TOOLS=Bash,Read,Write,Edit,Glob,Grep,Task,WebFetch,WebSearch,NotebookEdit

# ═══ Integrations (optional) ═══

# Gmail: configure accounts via web UI after first start
# GMAIL_POLL_INTERVAL=60000                # ms (default: 60s)
# GMAIL_MAX_BODY_LENGTH=500                # max chars to process per email

# Home Assistant
# HA_URL=
# HA_TOKEN=
# HA_ENTITIES=                             # comma-separated entity IDs
# HA_POLL_INTERVAL=60000                   # ms (default: 60s)

# Google Calendar
# CALENDAR_ENABLED=true
# CALENDAR_POLL_INTERVAL=300000            # ms (default: 5m)

# RSS Feeds: add feeds via web UI
# RSS_POLL_INTERVAL=900000                 # ms (default: 15m)

# OwnTracks location tracking (POST to /owntracks)
# OWNTRACKS_USER=
# OWNTRACKS_DEVICE=

# ═══ Paths (rarely need changing) ═══

# BRAIN_DIR=/data/brain
# GMAIL_DIR=/data/gmail
# AGENTS_DIR=/data/agents
# AUTH_STATE_DIR=./auth_state
# HISTORY_FILE=/data/chat-history.json
# LOG_FILE=./agent.log

# ═══ Startup ═══

# WA_STARTUP_DELAY=40                     # seconds before WhatsApp connect (deploy safety)
