# ═══ ARIA — Required ═══

# Your WhatsApp phone number in international format (e.g. 31612345678)
OWNER_PHONE=

# Your name (used in personality prompts)
OWNER_NAME=

# Anthropic API key for Claude
CLAUDE_API_KEY=

# Web dashboard password (leave empty to disable auth)
WEB_PASSWORD=

# ═══ Brain — Autonomous Reasoning ═══

# BRAIN_ENABLED=true
# BRAIN_MAX_MESSAGES_PER_DAY=5
# BRAIN_MIN_MESSAGE_INTERVAL=7200000
# BRAIN_QUIET_START=23
# BRAIN_QUIET_END=7

# ═══ Self-Improvement ═══

# SELF_IMPROVE_ENABLED=true
# SELF_IMPROVE_AUTO_APPROVE=false
# SELF_IMPROVE_MAX_PER_WEEK=3

# GitHub repo for self-improvement PRs (owner/repo format)
# GITHUB_REPO=
# GH_TOKEN=

# ═══ Integrations (optional) ═══

# Gmail: configure via web UI after first start
# Home Assistant
# HA_URL=
# HA_TOKEN=
# HA_ENTITIES=
